{
  "manifest_version": 3,
  "name": "Mango New Tab Studio Wallpapers & Widgets",
  "short_name": "Mango Studio",
  "description": "__MSG_extensionDescription__",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "default_locale": "en",
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "open-studio.js" },
  "action": {
    "default_title": "__MSG_openStudio__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "optional_permissions": ["history"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; connect-src 'self'; img-src 'self' data: blob:"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
